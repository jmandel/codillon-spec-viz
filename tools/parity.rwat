(func $is_even (param $x i32) (result (i32 | v == (x % 2 == 0 ? 1 : 0)))
  local.get $x
  i32.const 1
  i32.and
  i32.eqz
)
(func $half (param $x (i32 | v % 2 == 0)) (result (i32 | v + v == x))
  local.get $x
  i32.const 1
  i32.shr_s
)
(func $half_or_neg1 (param $x i32) (result (i32 | (x % 2 == 0 && v + v == x) || (x % 2 == 1 && v == -1)))
  local.get $x
  call $is_even
  i32.eqz
  if (result i32)
    i32.const -1
  else
    (@assert x % 2 == 0)
    local.get $x
    call $half
  end
)
